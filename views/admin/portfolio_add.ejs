    <div class="page-header">
        <h3>Add Portfolio</h3>
    </div>

    <form action="/admin/portfolio_add_save" method="post"  enctype="multipart/form-data">

        <label>Project Name</label>
        <input type="text" name="project_name" class="form-control mb-3">
     <label>Title</label>
