<div class="page-content">
<div class="container-fluid">
    <!-- Page Header -->
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-1">Testimonials</h1>
            <p class="text-muted small mb-0">Welcome back, Here's your overview</p>
        </div>
        <div>
            <button class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Add New
            </button>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-4">
        <div class="col-12">
            <form action="/admin/testimonial_add_save" method="post" enctype="multipart/form-data">
                <label>Client Name</label>
                <input type="text" name="client_name" class="form-control mb-4 " />
                
                <label>Client Position</label>
                <input type="text" name="client_position" class="form-control mb-4 " />

                <label>Description</label>
                <input type="text" name="testimonial_description" class="form-control mb-4 " />
                <label>Image</label>
    <input type="file" name="photo" class="form-control mb-4">
                <button class="btn btn-primary">Save</button>
            </form>
        </div>
    </div>

