<%- include('header.ejs'); %>

<!-- ===== DASHBOARD CONTENT ===== -->
<div class="page-content">
<div class="container-fluid">
    <!-- Page Header -->
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-1">Education List</h1>
            <p class="text-muted small mb-0">Welcome back, Here's your overview</p>
        </div>
        <div>
            <button class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Add New
            </button>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-4">
        <div class="col-12">
            <table border="1" class="table table-border">
                <tr>
                    <th>Id</th>
                    <th>edu_duration</th>
                    <th>edu_degree</th>
                    <th>edu_university</th>
                    <th>Status</th>
                </tr>
                <% for(var i=0;i<education.length;i++){ %>
                <tr>
                    <th><%= i+1 %></th>
                    <th><%=education[i].edu_duration%></th>
                    <th><%=education[i].edu_degree%></th>
                    <th><%=education[i].edu_university%></th>
                    <td>

    <a href="/admin/education_edit/<%= education[i].eid %>" class="btn btn-warning">
        <i class="fa fa-pencil"></i>
    </a>

    <a href="/admin/education_delete/<%= education[i].eid %>"
       class="btn btn-danger"
       onclick="return confirm('Delete this education?')">
        <i class="fa fa-trash"></i>
    </a>

</td>
                </tr>
                <% } %>
            </table>
        </div>
    </div>

<%- include('footer.ejs'); %>
