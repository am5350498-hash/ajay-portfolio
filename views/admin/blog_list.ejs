<%- include('header.ejs') %>

<div class="page-content">
<div class="container-fluid">

<h3>Blog List</h3>

<table class="table table-bordered">
<tr>
    <th>ID</th>
    <th>Image</th>
    <th>Date</th>
    <th>Post Name</th>
    <th>Description</th>
    <th>Read more</th>
    <th>Action</th>
</tr>

<% for(var i=0; i<blog.length; i++){ %>

<tr>

    <td><%= blog[i].id %></td>

    <td>
        <img src="/uploads/<%= blog[i].Image %>" width="100" height="80">
    </td>

    <td><%= blog[i].post_date %></td>

    <td><%= blog[i].post_name %></td>

    <td><%= blog[i].post_discription %></td>
    <td><%= blog[i].post_readmore %></td>

    <td>
        <a href="/admin/blog_edit/<%= blog[i].id %>" class="btn btn-warning">
            <i class="fa fa-pencil"></i>
        </a>

        <a href="/admin/blog_delete/<%= blog[i].id %>"
           onclick="return confirm('Delete Blog?')"
           class="btn btn-danger">
            <i class="fa fa-trash"></i>
        </a>
    </td>

</tr>

<% } %>

</table>

</div>
</div>

<%- include('footer.ejs') %>