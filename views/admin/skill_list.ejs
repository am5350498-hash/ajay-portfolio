<%- include('header.ejs'); %>

<!-- ===== DASHBOARD CONTENT ===== -->
<div class="page-content">
<div class="container-fluid">
    <!-- Page Header -->
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-1">Skill List</h1>
            <p class="text-muted small mb-0">Welcome back, Here's your overview</p>
        </div>
        <div>
            <button class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Add New
            </button>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-4">
        <div class="col-12">
            <table border="1" class="table table-border">
                <tr>
                    <th>Id</th>
                    <th>Tech Name</th>
                    <th>Tech Per(%)</th>
                    <th>Status</th>
                </tr>
                <% for(var i=0;i<skill.length;i++){ %>
                <tr>
                    <th><%= i+1 %></th>
                    <th><%=skill[i].tech_name%></th>
                    <th><%=skill[i].tech_per%></th>
                    <td>

    <a href="/admin/skill_edit/<%= skill[i].ts_id %>" class="btn btn-warning">
        <i class="fa fa-pencil"></i>
    </a>

    <a href="/admin/skill_delete/<%= skill[i].ts_id %>"
       class="btn btn-danger"
       onclick="return confirm('Delete this skill?')">
        <i class="fa fa-trash"></i>
    </a>

</td>
                </tr>
                <% } %>
            </table>
        </div>
    </div>

<%- include('footer.ejs'); %>
