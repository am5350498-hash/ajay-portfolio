<%- include('header.ejs') %>

<div class="page-content">
<div class="container-fluid">

<h3>Add Blog</h3>

<form action="/admin/blog_add_save" method="POST" enctype="multipart/form-data">

<div class="mb-3">
<label>Blog Image</label>
<input type="file" name="photo" class="form-control" required>
</div>

<div class="mb-3">
<label>Date</label>
<input type="text" name="post_date" class="form-control" required>
</div>

<div class="mb-3">
<label>Title</label>
<input type="text" name="post_name" class="form-control" required>
</div>

<div class="mb-3">
<label>Description</label>
<textarea name="post_discription" class="form-control" rows="5"></textarea>
</div>
<div class="mb-3">
<label>Read More</label>
<input type="link" name="post_readmore" class="form-control" >
</div>


<button class="btn btn-primary">Save</button>

</form>

</div>
</div>

<%- include('footer.ejs') %>



