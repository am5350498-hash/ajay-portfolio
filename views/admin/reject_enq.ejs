<%- include('header.ejs'); %>

<!-- ===== DASHBOARD CONTENT ===== -->
<div class="page-content">
<div class="container-fluid">
    <!-- Page Header -->
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-1">Reject EnquiryList</h1>
            <p class="text-muted small mb-0">Welcome back, Here's your overview</p>
        </div>
        <div>
            <button class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Add New
            </button>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-4">
        <div class="col-12">
            <table border="1" class="table table-border">
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Subject</th>
                    <th>Massege</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
                <% for(var i=0;i<data.length;i++){ %>
                <tr>
                       <td><%= data[i].cid %></td>
                        <td><%= data[i].cname %></td>
                        <td><%= data[i].cemail %></td>
                        <td><%= data[i].csubject %></td>
                        <td><%= data[i].cmessage %></td>
                        <td><%= data[i].cdate %></td>
                    <th>

    <a href="/admin/reject_confirm/<%= data[i].cid %>" class="btn btn-success">
    Confirm
</a>

</th>
                </tr>
                <% } %>
            </table>
        </div>
    </div>

<%- include('footer.ejs'); %>
